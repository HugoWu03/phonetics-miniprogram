.center { text-align: center; }
.big { font-size: 40rpx; }
.big-word {
  font-size: 72rpx;
  font-weight: 700;
  color: #2B3145;
  margin-top: 30rpx;
}
.meaning { color: #8A94A6; margin-bottom: 20rpx; }
.ipa-box {
  font-size: 44rpx;
  color: #4F7CFF;
  background: #EEF3FF;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
  display: inline-block;
}
.btns {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: 16rpx 0;
  flex-wrap: wrap;
}
.judge { margin-top: 30rpx; }
.rec-tip { margin-top: 16rpx; }
.start-btn { margin-top: 30rpx; }
.best { margin-top: 10rpx; }
.score {
  font-size: 88rpx;
  font-weight: 700;
  color: #4F7CFF;
  margin: 20rpx 0 8rpx;
}
.pass {
  background: #E6F7F0;
  color: #19A97B;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.pass.warn { background: #FFF4E5; color: #E8930C; }
